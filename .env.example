# Copy this file to .env and fill in your own values. .env is ignored by git.

# LlamaParse OCR for scanned invoices (https://cloud.llamaindex.ai)
LLAMA_CLOUD_API_KEY=

# n8n basic auth (docker-compose.yml)
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change-me

# n8n sandbox service (docker-compose.yml). Any long random strings.
SANDBOX_API_KEYS=change-me
SANDBOX_API_RUNNER_REGISTRATION_TOKEN=change-me
SANDBOX_API_RUNNER_API_KEY=change-me

# The other keys (Google Gemini, NVIDIA NIM, Cohere, Airtable, SMTP) are not read
# from this file: create them as credentials inside n8n (Settings > Credentials).
# They are stored encrypted in n8n_data/, which is never committed.
