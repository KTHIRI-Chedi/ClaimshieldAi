one JSON object with the keys score, pass and reasoning:\\n- If valid policy facts are present:\\n  {\\\"score\\\": 5, \\\"pass\\\": true, \\\"reasoning\\\": \\\"Response contains verified policy clauses.\\\"}\\n- If fallback text, refusal, or missing policy context:\\n  {\\\"score\\\": 1, \\\"pass\\\": false, \\\"reasoning\\\": \\\"Response contains fallback disclaimer or lacks retrieved policy context.\\\"}\"],\"options\":{\"lc\":1,\"type\":\"not_implemented\",\"id\":[\"langchain\",\"chat_models\",\"ollama\",\"ChatOllama\"]},\"response\":{\"response\":{\"generations\":[[{\"text\":\"{\\\"score\\\": 5, \\\"pass\\\": true, \\\"reasoning\\\": \\\"Response contains verified policy clauses. It cites Section I of the Package policy, IMT codes 22 and 32, and mentions coverage conditions like authorized driver and private use, as well as exclusions like wear and tear and misuse.\\\"}\"}]]},\"tokenUsageEstimate\":{\"completionTokens\":63,\"promptTokens\":411,\"totalTokens\":474}}}"}}
