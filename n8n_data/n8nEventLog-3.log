usal, or missing policy context:\\n  {\\\"score\\\": 1, \\\"pass\\\": false, \\\"reasoning\\\": \\\"Response contains fallback disclaimer or lacks retrieved policy context.\\\"}\"],\"options\":{\"openai_api_key\":{\"lc\":1,\"type\":\"secret\",\"id\":[\"OPENAI_API_KEY\"]},\"model\":\"qwen/qwen3.8-27b\",\"max_tokens\":200,\"temperature\":0,\"max_retries\":2,\"configuration\":{\"defaultHeaders\":{\"openai-platform\":\"org-qkmJQuJ2WnvoIKMr2UJwIJkZ\"},\"baseURL\":\"https://api.groq.com/openai/v1\",\"fetchOptions\":{\"dispatcher\":{\"_events\":{},\"_eventsCount\":0}}},\"model_kwargs\":{},\"supports_strict_tool_calling\":false},\"response\":{\"response\":{\"generations\":[[{\"text\":\"{\\n\\\"score\\\": 5,\\n\\\"pass\\\": true,\\n\\\"reasoning\\\": \\\"Response contains verified policy clauses.\\\"\\n}\",\"generationInfo\":{\"finish_reason\":\"stop\"}}]]},\"tokenUsage\":{\"completionTokens\":29,\"promptTokens\":378,\"totalTokens\":407}}}"}}
