    {
      "parameters": {
        "jsCode": "// Builds the result page shown after the form is submitted: what the customer sees,\n// and below it the internal decision record (for the demo).\nconst r = $input.first().json;\nconst started = new Date($('Prepare Claim').first().json.claim.submitted_at);\nconst seconds = Math.round((Date.now() - started) / 1000);\nconst esc = s => String(s ?? '').replace(/[&<>\"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;' }[c]));\nconst COLORS = { auto_approve: '#1a7f37', human_review: '#9a6700', fraud_investigation: '#cf222e', rejected: '#57606a' };\nconst LABELS = { auto_approve: 'Auto-approved', human_review: 'Human review', fraud_investigation: 'Fraud investigation', rejected: 'Rejected' };\n\nconst signs = (r.warning_signs || []).map(s => `<li><b>${esc(s.code)}</b> (+${s.points}): ${esc(s.detail)}</li>`).join('') || '<li>None</li>';\nconst reasons = (r.route_reasons || []).map(x => `<li>${esc(x)}</li>`).join('');\nconst agents = Object.entries(r.agents || {}).map(([k, v]) => `<tr><td style=\"padding:4px 8px;color:#57606a\">${esc(k)}</td><td style=\"padding:4px 8px\">${esc(v)}</td></tr>`).join('');\n\nconst html = `\n<div style=\"font-family:system-ui,sans-serif;max-width:720px;margin:24px auto;padding:24px 28px;background:#fff;border:1px solid #d0d7de;border-radius:10px;text-align:left;line-height:1.5;font-size:15px\">\n  <h2 style=\"margin-bottom:4px\">Claim ${esc(r.claim_id)}</h2>\n  <div style=\"padding:14px;border-radius:8px;background:#f6f8fa;margin:12px 0\">${esc(r.customer_message)}</div>\n  <h3 style=\"margin-top:24px\">Internal decision record (demo)</h3>\n  <p><span style=\"background:${COLORS[r.route] || '#57606a'};color:#fff;padding:4px 10px;border-radius:12px\">${LABELS[r.route] || esc(r.route)}</span>\n  ${r.risk_score !== null && r.risk_score !== undefined ? `&nbsp; Risk score <b>${r.risk_score}</b>/100 (rules ${r.rule_score}, AI +${r.llm_adjustment})` : ''}</p>\n  <p><b>Next action:</b> ${esc(r.next_action)}</p>\n  <p style=\"margin:12px 0 0\"><b>Why:</b></p><ul style=\"margin:4px 0 12px 20px;padding:0\">${reasons}</ul>\n  <p style=\"margin:12px 0 0\"><b>Warning signs:</b></p><ul style=\"margin:4px 0 12px 20px;padding:0\">${signs}</ul>\n  ${r.justification ? `<p><b>AI justification:</b> ${esc(r.justification)}</p>` : ''}\n  ${agents ? `<p><b>Agent results:</b></p><table style=\"border-collapse:collapse;font-size:14px\">${agents}</table>` : ''}\n  <p style=\"color:#57606a;font-size:13px\">Processed in ${seconds} s. Saved to Airtable (Claims).</p>\n</div>`;\n\nreturn [{ json: { ...r, html } }];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
