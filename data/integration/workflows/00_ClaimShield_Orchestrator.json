      "id": "770f09d8-3443-46b1-ac48-19a8f8fbc089",
      "name": "Incident Plausibility",
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// Puts every agent's answer into the format the Fraud Risk & Decision agent reads.\n// An agent that failed is passed as { error: true } so the claim goes to a human.\nconst failure = (r, name) => {\n  if (r && !r.error) return null;\n  const e = r?.error;\n  const message = typeof e === 'string' ? e : e?.message || r?.error_message || r?.reason || `${name} returned nothing`;\n  return { error: true, error_message: String(message).slice(0, 500) };\n};\nconst first = name => { try { return $(name).first().json; } catch (e) { return null; } };\n\nconst claim = $('Prepare Claim').first().json.claim;\nconst validation = first('Validate Claim');\n\n// Visual Inspection (Fedi): field names differ slightly from the decision agent's.\nconst v = first('Visual Inspection');\nconst visual = failure(v, 'Visual Inspection') || {\n  ...v,\n  damaged_parts: v.damaged_parts ?? v.damaged_items ?? [],\n  photo_reused: v.duplicate_photo_detected === true,\n  reused_from_claims: (v.duplicate_photos || []).map(d => d.previous_claim_id),\n  same_vehicle_across_photos: v.same_asset_across_photos,\n};\n\nconst inv = first('Invoice Parser');\nconst invoice = failure(inv, 'Invoice Parser') || inv;\n\nconst rag = first('Policy RAG');\nconst policy_rag = failure(rag && rag.coverage_status ? rag : { error: rag?.error || 'no coverage_status in the answer' }, 'Policy RAG') || {\n  coverage_status: rag.coverage_status, cited_clauses: rag.cited_clauses, reasoning: rag.reasoning, eval_score: rag.eval_score,\n};\n\nconst pl = first('Incident Plausibility');\nconst plausibility = failure(pl && pl.agent ? pl : { error: pl?.error || 'no result' }, 'Incident Plausibility') || pl;\n\nreturn [{ json: { stage: 'decide', claim, validation, visual, invoice, policy_rag, plausibility } }];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3080,
        160
      ],
      "id": "4f5e7e35-c2db-4294-b2a4-6d9aa228735f",
      "name": "Collect Agent Results"
