    {
      "parameters": {
        "jsCode": "// Turns the form answers into the claim that every agent reads, and gives it an ID.\n// Photos keep their binary keys (photos_0, photos_1...); the invoice PDF goes to \"invoice\".\nconst f = $input.first().json;\nconst bin = $input.first().binary ?? {};\nconst pad = n => String(n).padStart(2, '0');\nconst now = new Date();\nconst claim_id = `CLM-${now.getFullYear()}${pad(now.getMonth() + 1)}${pad(now.getDate())}-${pad(now.getHours())}${pad(now.getMinutes())}${pad(now.getSeconds())}`;\n\nconst photos = {};\nlet invoice = null;\nfor (const [key, file] of Object.entries(bin)) {\n  if (key.startsWith('invoice')) invoice = file;\n  else if (String(file.mimeType).startsWith('image/')) photos[`photos_${Object.keys(photos).length}`] = file;\n}\n\nconst date = String(f.incident_date || '').slice(0, 10);\nconst time = /^\\d{1,2}:\\d{2}$/.test(String(f.incident_time || '').trim())\n  ? String(f.incident_time).trim().padStart(5, '0') : '12:00';\n\nconst claim = {\n  claim_id,\n  policy_id: String(f.policy_id || '').trim().toUpperCase(),\n  incident_date: date,\n  incident_datetime: `${date}T${time}:00`,\n  incident_location: String(f.incident_location || '').trim(),\n  claim_type: f.claim_type || 'collision',\n  description: String(f.description || '').trim(),\n  claimed_amount: Number(f.claimed_amount),\n  photo_count: Object.keys(photos).length,\n  has_invoice: invoice !== null,\n  submitted_at: now.toISOString(),\n};\n\nreturn [{ json: { stage: 'validate', claim }, binary: { ...photos, ...(invoice ? { invoice } : {}) } }];\n"
      },
