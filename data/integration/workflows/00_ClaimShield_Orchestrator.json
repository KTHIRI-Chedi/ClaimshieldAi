      "parameters": {
        "jsCode": "// The Invoice Parser reads the invoice from a file path, so the uploaded PDF is saved to\n// /data/invoices/<claim_id>.pdf first (the data folder of the project, shared with n8n).\nconst { claim } = $('Prepare Claim').first().json;\nconst { invoice } = $('Prepare Claim').first().binary ?? {};\nreturn [{ json: { file_path: `/data/invoices/${claim.claim_id}.pdf`, claim_id: claim.claim_id }, binary: { invoice } }];\n"
