      "id": "d64d186e-d9d9-4d98-aca6-d3b3e17d79c5",
      "name": "Policy RAG",
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// Input of the Incident Plausibility agent: the story, where and when it happened,\n// and the parts on the invoice (to check they fit the accident).\nconst { claim } = $('Prepare Claim').first().json;\nconst inv = $('Invoice Parser').first().json;\nreturn [{\n  json: {\n    claim: {\n      claim_id: claim.claim_id,\n      incident_datetime: claim.incident_datetime,\n      incident_location: claim.incident_location,\n      description: claim.description,\n    },\n    invoice: { line_items: (inv.line_items || []).filter(li => li.part).map(li => ({ part: li.part })) },\n  },\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2640,
        160
      ],
      "id": "ebe25fde-899f-4821-be60-fa8db13bc543",
      "name": "Plausibility Input"
    },
    {
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "value": "VeGTlxAhlxLRtI3N",
          "mode": "list",
          "cachedResultName": "ClaimShield - Incident Plausibility Agent (local fine-tuned)",
          "cachedResultUrl": "/workflow/VeGTlxAhlxLRtI3N"
        },
        "mode": "once",
        "options": {
          "waitForSubWorkflow": true
        }
      },
