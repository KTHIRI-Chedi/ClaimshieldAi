          "__rl": true,
          "value": "FwCOIOAfJsT7eTvB",
          "mode": "list",
          "cachedResultName": "RAG Agent & LLM-as-a-Judge Pipeline",
          "cachedResultUrl": "/workflow/FwCOIOAfJsT7eTvB"
        },
