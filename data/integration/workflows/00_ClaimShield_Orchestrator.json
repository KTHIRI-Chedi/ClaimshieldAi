    {
      "parameters": {
        "jsCode": "// Input of the Policy RAG agent: the claim (it turns it into a coverage question itself).\nconst { claim } = $('Prepare Claim').first().json;\nreturn [{ json: { claim: { claim_id: claim.claim_id, claim_type: claim.claim_type, description: claim.description } } }];\n"
