      "id": "992f6218-04dd-497d-bd35-6f305faea3a3",
      "name": "Decide",
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// The decision record: what was decided and why, plus each agent's short result.\nconst d = $input.first().json;\nconst input = $('Collect Agent Results').first().json;\nconst { claim } = input;\nconst ok = d.route && !d.error;\nconst summary = (r, text) => (r && !r.error ? text(r) : `failed: ${r?.error_message || 'no result'}`);\n\nreturn [{\n  json: {\n    claim_id: claim.claim_id,\n    policy_id: claim.policy_id,\n    incident_date: claim.incident_date,\n    claimed_amount: claim.claimed_amount,\n    route: ok ? d.route : 'human_review',\n    risk_score: d.risk_score ?? null,\n    rule_score: d.rule_score ?? null,\n    llm_adjustment: d.llm_adjustment ?? null,\n    warning_signs: d.warning_signs ?? [],\n    route_reasons: ok ? d.route_reasons : [`Decision agent failed: ${d.error?.message || d.error || 'no result'}`],\n    justification: d.justification ?? '',\n    coverage: d.coverage ?? null,\n    missing_inputs: d.missing_inputs ?? [],\n    deductible: input.validation?.policy?.deductible ?? null,\n    agents: {\n      visual: summary(input.visual, v => v.summary || `severity ${v.damage_severity}/5, damaged: ${(v.damaged_parts || []).join(', ')}`),\n      invoice: summary(input.invoice, i => `${i.status}${i.arithmetic_issue ? `: ${i.arithmetic_issue}` : ''} (${(i.line_items || []).length} lines)`),\n      policy_rag: summary(input.policy_rag, p => `${p.coverage_status}${p.cited_clauses?.length ? ` (${p.cited_clauses.join(', ')})` : ''}`),\n      plausibility: summary(input.plausibility, p => p.summary),\n      photos: (() => {\n        const pc = input.validation?.photo_checks;\n        if (!pc) return 'not checked';\n        return `${pc.photos_checked} checked, ${pc.photo_reused ? `reused from ${pc.reused_from_claims.join(', ')}` : 'none reused'}, dates: ${pc.photo_taken_dates.join(', ') || 'none in the files'}`;\n      })(),\n    },\n  },\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3520,
        160
      ],
      "id": "b8780dbb-86c4-4e92-9865-1b5824c14901",
      "name": "Decision Record"
    },
    {
      "parameters": {
        "jsCode": "// A claim that failed validation is rejected before any AI agent runs.\nconst v = $input.first().json;\nconst { claim } = $('Prepare Claim').first().json;\nconst reasons = v.error\n  ? [`Validation could not run: ${v.error?.message || v.error}`]\n  : (v.reasons?.length ? v.reasons : ['Claim is not valid']);\nreturn [{\n  json: {\n    claim_id: claim.claim_id,\n    policy_id: claim.policy_id,\n    incident_date: claim.incident_date,\n    claimed_amount: claim.claimed_amount,\n    route: 'rejected',\n    risk_score: null,\n    warning_signs: [],\n    route_reasons: reasons,\n    agents: {},\n  },\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
